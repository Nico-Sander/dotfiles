;; --- Kanata config file ---
;; - Systems:                   Ubuntu (GNOME, Wayland) and Windows 11
;; - Kanata:                    v1.12.0 (https://github.com/jtroo/kanata/releases)
;; - OS Keyboard Layout:        Linux:   English (US, intl., with AltGr dead keys)  -> xkb "us+altgr-intl"
;;                              Windows: US QWERTY
;; - Physical Keyboard Layout:  Works with both ANSI (NA) and ISO (EU) layouts

;; --- Functionalities ---
;; - Colemak layout

;; - Homerow mods. A hold only counts when you press AND release a key on the
;;   OTHER hand while still holding the mod. Overlapping rolls stay letters.
;;      - a: left meta / super / Windows     - o: right meta
;;      - r: left alt                        - i: left alt (right alt is AltGr on Linux)
;;      - s: left shift                      - e: right shift
;;      - t: left ctl                        - n: right ctl

;; - German special characters while ctl is held (t, n or the physical left ctl)
;;      - ö: ctl + o       Ö: ctl + shift (s) + o
;;      - ä: ctl + '       Ä: ctl + shift (s) + '
;;      - ü: ctl + [       Ü: ctl + shift (s) + [
;;      - ß: ctl + ]


(defcfg
    process-unmapped-keys yes
    ;; Lets several homerow mods resolve at the same time (e.g. ctl + shift).
    concurrent-tap-hold yes
    ;; If another key was pressed less than this many ms ago, a homerow key is
    ;; always a letter. Stops mods from firing in the middle of fast typing.
    ;; Shift turns this off for itself (see below) so capitals after a space work.
    tap-hold-require-prior-idle 150
)

;; Physical (QWERTY) key positions per hand, used by tap-hold-opposite-hand-release.
;; b is deliberately in neither hand: you hit it with both hands, so both sides'
;; mods treat it like an other-hand key (s + b and e + b both give B).
;; Keys not listed here (b, space, numbers, enter, ...) follow (unknown-hand hold).
(defhands
    (left  q w e r t a s d f g z x c v)
    (right y u i o p [ ] h j k l ; ' n m , . /)
)

;; The source is the default US QWERTY layout (not all keys specified)
(defsrc
                    q   w   e   r   t   y   u   i   o   p   [   ]
    caps            a   s   d   f   g   h   j   k   l   ;   '
                    z   x   c   v   b   n   m
    lctl            spc
)

;; Homerow mod timing. Hold-time = how long a key must be held on its own
;; (no other key pressed) before it counts as a modifier, e.g. for mod + click.
;; Normal shortcuts don't wait for this: they resolve as soon as the other key is released.
(defvar
    hold-shift 220
    hold-ctl   220
    hold-slow  260      ;; ring/pinky (alt, meta) are slower and misfire more
    repress    200      ;; tap, then press+hold again within this time -> letter repeats (aaaaaa)
)

;; Template for a homerow mod:
;; - other-hand key pressed and released while held -> modifier
;; - same-hand key pressed  -> letter (rolls like "st", "ar" stay letters)
;; - mod released first     -> letter (cross-hand rolls like "th", "ne" stay letters)
;; - held alone past the hold time -> modifier
;; - key on no hand (b, numbers, enter, ...) -> like the other hand (press + release)
;; The other homerow mods of the same hand are "neutral": pressing one while a
;; mod is waiting does not turn it into a letter, so mods can be stacked (ctl + shift).
;; Space is neutral too, so a mod never fires because of a space.
(deftemplate hrm-l (hold-time key mod idle)
    (tap-hold-opposite-hand-release $hold-time $key $mod
        (timeout hold)
        (neutral-keys a s d f spc)
        (unknown-hand hold)
        (tap-repress-timeout $repress)
        (require-prior-idle $idle))
)
(deftemplate hrm-r (hold-time key mod idle)
    (tap-hold-opposite-hand-release $hold-time $key $mod
        (timeout hold)
        (neutral-keys j k l ; spc)
        (unknown-hand hold)
        (tap-repress-timeout $repress)
        (require-prior-idle $idle))
)

(defalias
    ;; ctl + the ctl-layer (umlauts). Used by t, n and the physical left ctl.
    lctl-uml (multi lctl (layer-while-held ctl-layer))
    rctl-uml (multi rctl (layer-while-held ctl-layer))

    a (t! hrm-l $hold-slow  a lmet      150)
    r (t! hrm-l $hold-slow  r lalt      150)
    s (t! hrm-l $hold-shift s lsft      0)
    t (t! hrm-l $hold-ctl   t @lctl-uml 150)

    n (t! hrm-r $hold-ctl   n @rctl-uml 150)
    e (t! hrm-r $hold-shift e rsft      0)
    i (t! hrm-r $hold-slow  i lalt      150)
    o (t! hrm-r $hold-slow  o rmet      150)
)

;; Umlaut output differs per OS.
;; Linux: let the "us+altgr-intl" layout produce the characters (AltGr + q/p/y/s).
;;        unmod lifts ctl just for this key so the app doesn't see ctl + AltGr;
;;        shift stays held, so the OS gives the capital by itself.
;;        (kanata's unicode action uses Ctrl+Shift+U on Linux, which WezTerm grabs.)
(platform (linux)
    (defalias
        ae (unmod (lctl rctl) ralt q)
        oe (unmod (lctl rctl) ralt p)
        ue (unmod (lctl rctl) ralt y)
        ss (unmod (lctl rctl) ralt s)
    )
)

;; Windows: unicode works reliably, but ignores shift, so pick the capital ourselves.
(platform (win winiov2 wintercept)
    (defalias
        ae (switch ((or lsft rsft)) (unicode Ä) break () (unicode ä) break)
        oe (switch ((or lsft rsft)) (unicode Ö) break () (unicode ö) break)
        ue (switch ((or lsft rsft)) (unicode Ü) break () (unicode ü) break)
        ss (unicode ß)
    )
)

;; Space-hold for another layer
(defalias
    spc (tap-hold-release $repress 200 spc (layer-while-held nav))
)

;; Default layer: Colemak with homerow mods. Caps is Esc.
(deflayer base
                    q   w   f   p   g   j   l   u   y   ;   [   ]
    esc             @a  @r  @s  @t  d   h   @n  @e  @i  @o  '
                    z   x   c   v   b   k   m
    @lctl-uml       @spc
)

;; Active while ctl is held: German special characters. Everything else falls
;; through, so all other ctl shortcuts work as usual.
(deflayer ctl-layer
                    _   _   _   _   _   _   _   _   _   _   @ue @ss
    _               _   _   _   _   _   _   _   _   _   @oe @ae
                    _   _   _   _   _   _   _
    _               _
)

;; Active while space is held (hold space FIRST, then the other keys).
;; - Top row: numbers, then - and =. With shift (s): ! @ # $ % ^ & * ( ) _ +
;; - a r s t: plain mods (no tap/hold), for shift/ctl + arrows and shift + numbers
;; - d: \ (shift: |)
;; - h and ': home / end, on both sides of the arrows
;; - n e i o: arrows (vim order)
;; - Bottom row: ` (shift: ~)  ( )  { }  then pgup pgdn
(deflayer nav
                    1     2     3     4     5     6     7     8     9     0     -     =
    _               lmet  lalt  lsft  lctl  \     home  left  down  up    rght  end
                    grv   S-9   S-0   S-[   S-]   pgup  pgdn
    _               _
)

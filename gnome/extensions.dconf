[blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>, 'unscaled_radius': <0>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0>, 'unscaled_radius': <30>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}}

[blur-my-shell/appfolder]
blur=true
brightness=0.59999999999999998
sigma=100

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=1.0
override-background=true
pipeline='pipeline_default_rounded'
sigma=0
static-blur=false
style-dash-to-dock=0
unblur-in-overview=false

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=2

[blur-my-shell/panel]
blur=true
brightness=0.48999999999999999
corner-radius=0
force-light-text=true
override-background=true
pipeline='pipeline_default'
sigma=0
static-blur=false
style-panel=0
unblur-in-overview=true

[blur-my-shell/popup]
brightness=0.29999999999999999
override-background=true
pipeline='pipeline_default_rounded'
sigma=60
static-blur=true

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
always-center-icons=false
animation-time=0.10000000000000001
app-ctrl-hotkey-1=@as []
app-ctrl-hotkey-10=@as []
app-ctrl-hotkey-2=['<Ctrl><Super>2']
background-color='rgb(0,0,0)'
background-opacity=0.050000000000000003
click-action='focus-or-previews'
custom-background-color=false
custom-theme-shrink=true
dash-max-icon-size=24
dock-fixed=true
dock-position='LEFT'
extend-height=true
height-fraction=0.90000000000000002
hide-tooltip=true
hot-keys=false
intellihide-mode='ALL_WINDOWS'
middle-click-action='launch'
multi-monitor=true
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
running-indicator-style='SQUARES'
scroll-action='do-nothing'
shift-click-action='launch'
shift-middle-click-action='minimize'
show-mounts=false
show-mounts-network=false
show-mounts-only-mounted=false
show-show-apps-button=false
show-trash=false
show-windows-preview=true
transparency-mode='DEFAULT'

[ding]
check-x11wayland=true
show-home=false

[focus]
inactive-opacity=uint32 85
is-background-blur=false
is-desaturate-enabled=false

[just-perfection]
accessibility-menu=false
activities-button=true
animation=4
dash-separator=true
keyboard-layout=true
panel=true
quick-settings=true
quick-settings-airplane-mode=false
quick-settings-backlight=false
quick-settings-dark-mode=false
quick-settings-do-not-disturb=false
show-apps-button=true
startup-status=0
type-to-search=true
weather=false
workspace-switcher-size=0
workspace-thumbnail-to-main-view=false
workspace-wrap-around=true
world-clock=false

[multi-monitors-bar]
thumbnails-slider-position='none'

[perfect-fit]
resize=['<Alt><Super>c']
resize-and-fit=['<Super>c']
scale-factor=0.80000000000000004

